{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadGuard X Arabic Annotation Schema",
  "description": "مخطط تصنيف بشري لتقييم الثريدات والتغريدات العربية في ThreadGuard X.",
  "type": "object",
  "required": ["id", "split", "is_synthetic", "tweets", "primary_label", "context_type"],
  "properties": {
    "id": { "type": "string" },
    "split": { "type": "string", "enum": ["train", "validation", "test"] },
    "is_synthetic": { "type": "boolean" },
    "tweets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "primary_label": {
      "type": "string",
      "enum": [
        "طبيعي",
        "سبام",
        "تكرار",
        "تسويق مزعج",
        "رابط مشبوه",
        "يحتاج مراجعة",
        "مؤشر مخالفة محتمل",
        "مشكلة في جودة الثريد"
      ]
    },
    "secondary_labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context_type": {
      "type": "string",
      "enum": [
        "شرح تقني",
        "محتوى تعليمي",
        "إعلان طبيعي",
        "نقد أو تحذير",
        "تسويق متكرر",
        "ترويج مزعج",
        "احتيال أو مخالفة محتملة"
      ]
    },
    "notes": { "type": "string" }
  }
}
